<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_book_item_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/image_book_item_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Cover image"
            tools:background="@android:color/holo_red_dark" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_book_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/text_book_item_author"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_book_item_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Titulo falso" />

    <TextView
        android:id="@+id/text_book_item_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/text_book_item_title"
        app:layout_constraintStart_toStartOf="@id/text_book_item_title"
        app:layout_constraintTop_toBottomOf="@+id/text_book_item_title"
        tools:text="Autor inventado" />

</androidx.constraintlayout.widget.ConstraintLayout>